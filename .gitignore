# No trailing slash: that form matches a directory only, and a symlinked
# node_modules (a worktree pointing at a sibling checkout's install) slipped
# straight past it and got committed — absolute path and all.
node_modules
dist/
dist-prod/
*.zip
.DS_Store
# SPEC.md is a private product doc kept outside this repo and symlinked in when
# it happens to be checked out alongside. Never committed: this repo is public.
# CLAUDE.md / AGENTS.md ARE committed — technical conventions, no business content.
SPEC.md

# Env & secrets (none used today; standard guard)
.env
.env.*
!.env.example
*.log

# Dev-only sample CV renders
sample-cvs/
